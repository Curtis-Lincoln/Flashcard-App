#: import NoTransition kivy.uix.screenmanager.NoTransition
#: import Factory kivy.factory.Factory
<MyDropDown@DropDown>:
    max_height: 435

<MyPopup@Popup>:
    auto_dismiss: True
    size_hint: 0.6, 0.85
    pos_hint: {"x": 0.2, "top": 0.9}
    title: "Forgot Your Password"

    MDBoxLayout:
        orientation: "vertical"

        MDLabel:
            text: "Email"
            font_size: 20
            color: 1,1,1,1

        MDTextField: 
            id: Email
            hint_text: "Email"
            icon_right: "email"
            size_hint_x: None
            width: 750
            height: 25
            font_size: 20
            mode: "round"
            padding_x: 10

        MDLabel:
            text: "Username"
            font_size: 20
            color: 1,1,1,1

        MDTextField: 
            id: User
            hint_text: "Username"
            icon_right: "account"
            size_hint_x: None
            width: 750
            height: 25
            font_size: 20
            mode: "round"
            padding_x: 10

        Button:
            text: "Recieve Code"
            font_size: 20
            on_release: app.CheckDetails(root)

        MDLabel:
            text: "Code"
            font_size: 20
            color: 1,1,1,1

        MDTextField: 
            id: Code
            hint_text: "Type Code"
            size_hint_x: None
            icon_right: "dialpad"
            width: 750
            height: 25
            font_size: 20
            mode: "round"
            padding_x: 10
            disabled: True
        
        Button:
            id: CodeButton
            text: "Check Code"
            font_size: 20
            disabled: True
            on_release: app.CheckCode(root)

        MDLabel:
            text: "Password"
            font_size: 20
            color: 1,1,1,1

        MDTextField: 
            id: Pwd
            hint_text: "New Password"
            icon_right: "eye-off"
            size_hint_x: None
            width: 750
            height: 25
            font_size: 20
            mode: "round"
            padding_x: 10
            disabled: True
        
        Button: 
            id: Submit
            text: "Submit"
            font_size: 20
            disabled: True
            on_release: app.ChangePassword(root)

        Button: 
            text: "Close"
            font_size: 20
            on_release: root.dismiss()


        MDLabel: 
            id: ErrorMessage
            text: ""
            font_size: 20
            color: 1,1,1,1
    
<ChangeDifficulty@Popup>:
    auto_dismiss: True
    size_hint: 0.6, 0.6
    pos_hint: {"x": 0.2, "top": 0.7}
    title: "Change Difficulty"

    MDBoxLayout: 
        orientation: "vertical"
        spacing: 50

        Button:
            id: Easy
            text: "Easy Question"
            disabled: False
            on_release: 
                root.ids.Easy.disabled = True
                root.ids.Medium.disabled = False 
                root.ids.Hard.disabled = False 
                root.ids.Confirm.disabled = False           

        Button:
            id: Medium
            text: "Medium Question"
            disabled: False 
            on_release:
                root.ids.Easy.disabled = False
                root.ids.Medium.disabled = True 
                root.ids.Hard.disabled = False           
                root.ids.Confirm.disabled = False
        
        Button:
            id: Hard
            text: "Hard Question"
            disabled: False
            on_release: 
                root.ids.Easy.disabled = False
                root.ids.Medium.disabled = False 
                root.ids.Hard.disabled = True
                root.ids.Confirm.disabled = False

        MDLabel:
            id: ErrorMessage
            text: ""
            color: 1,1,1,1

        Button:
            id: Confirm
            text: "Confirm"
            disabled: True
            on_release: app.Select(root)

        Button: 
            text: "Close"
            font_size: 20
            on_release: root.dismiss()

<Confirm@Popup>:
    auto_dismiss: True
    size_hint: 0.6, 0.6
    pos_hint: {"x": 0.2, "top": 0.7}
    title: "Are you sure you want to confirm this action?"

    MDBoxLayout:
        orientation: "vertical"

        MDLabel: 
            text: "Are you sure you want to confirm this action?"
            color: 1,1,1,1

        Button: 
            id: Yes
            text: "Yes"
            disabled: False
            on_release: 
                root.ids.Yes.disabled = True
                root.ids.No.disabled = False
                root.ids.Confirm.disabled = False

        Button: 
            id: No
            text: "No"
            disabled: False
            on_release:
                root.ids.Yes.disabled = False
                root.ids.No.disabled = True
                root.ids.Confirm.disabled = False

        Button: 
            id: Confirm
            text: "Confirm"
            disabled: True
            on_release: 
                app.Confirm(root)

        MDLabel:
            id: Error
            text: ""
            color: 1,1,1,1


            
            
<InputAndButton>:
    spacing: 25
    
    MDTextField:
        id: Title 
        hint_text: "Title"
        height: 25
        width: 850
        size_hint_x: None
        mode: "round"
    
    MDRaisedButton:
        id: Submit
        text: "Submit"
        on_release: 
            root.addset()
            app.addvalues("CreateSelection")

<MDCard>:
    size_hint: None, None
    size: 1800, 800
    pos_hint: {"center_x": 0.5, "center_y": 0.5}
    elevation: 10
    padding: 25
    spacing: 25
    orientation: "vertical"

<MDTopAppBar>:
    title: ""
    md_bg_color: 0,1,0,1

<TopBar@BoxLayout>:
    BoxLayout: 
        orientation: "horizontal"
        spacing: 40
        padding: [0,25]

        Spinner:
            id: spinner_id
            size_hint: 0.3, 0.5
            dropdown_cls: "MyDropDown"
            text: "Select"
            values: ["Learn", "Add", "Edit"]
            size_hint_y: None
            height: 50
            disabled: False

            on_text: app.spinner_clicked(spinner_id.text)
        
        MDTextField:
            id: searchbar
            hint_text: "Search Set"
            icon_right: "magnify"
            width: 300
            height: 25
            font_size: 30
            mode: "round"
            disabled:  False
            pos_hint: {"center_x": 0.5}
        
        MDFillRoundFlatButton:
            id: Search
            text: "Search"
            font_size: 25
            disabled: False
            on_release: 
                app.search()
                app.root.transition.direction = "left"

        MDFillRoundFlatButton:
            id: Clear
            text: "Clear"
            font_size: 25
            disabled: False
            on_release: 
                app.searchbarclear()

        MDFillRoundFlatButton:
            id: HelpButton
            text: "Help"
            font_size: 25
            disabled: False
            on_release: 
                app.root.current = "Help"
                app.root.transition.direction = "left"
                

        MDFillRoundFlatButton:
            id: Account
            text: "Account"
            font_size: 25
            disabled: False
            on_release: 
                app.root.current = "Account"
                app.root.transition.direction = "left"

<NavBar@BoxLayout>:
    BoxLayout:
        orientation: "vertical"
        spacing: 10
        padding: [0,-25]

        MDRaisedButton: 
            id: HomeButton
            text: "Home Page"
            font_size: 40
            style: "elevated"
            size_hint_x: 0.25
            disabled: False
            on_release: 
                app.root.current = "Home"
                app.root.transition.direction = "left"

        MDRaisedButton: 
            id: LearnFlashcard
            text: "Learn Flashcards"
            font_size: 35
            style: "elevated"
            size_hint_x: 0.25
            disabled: False
            on_release: 
                app.root.current = "LearnSelection"
                app.addvalues("LearnSelection")
                app.root.transition.direction = "left"


        MDRaisedButton: 
            id: CreateFlashcard
            text: "Create Flashcards"
            font_size: 35
            style: "elevated"
            size_hint_x: 0.25
            disabled: False
            on_release: 
                app.addvalues("CreateSelection")
                app.root.current = "CreateSelection"
                app.root.transition.direction = "left"


        MDRaisedButton: 
            id: ProgressButton
            text: "Progress"
            font_size: 35
            style: "elevated"
            size_hint_x: 0.25
            disabled: False
            on_release: 
                app.root.current = "Progress"
                app.root.transition.direction = "left"

        MDRaisedButton: 
            id: PreMadeButton
            text: "Pre-Made Flashcards"
            font_size: 35
            style: "elevated"
            size_hint_x: 0.25
            disabled: False
            on_release: 
                app.root.current = "LearnSelection"
                app.root.transition.direction = "left"
                app.addvalues("Pre-Made")

        MDSmartTile: 
            size_hint: None, None
            size: "180dp", "180dp"
            source: "Logo.PNG" 
            radius: [dp(24), dp(24)]
            overlap: False
            box_color: 1,1,1,1
            pos_hint: {"center_x": 0.1}

<Login>:
    MDCard:
  
        MDLabel:
            id: signup_label
            text: "LOGIN"
            font_size: 45
            size_hint_y: None
            height: self.texture_size[1]
            padding_x: 10

        MDLabel:
            id: username_label
            text: "USERNAME"
            font_size: 30
            size_hint_y: None
            height: self.texture_size[1]
            padding_y: 10
            padding_x: 10
        
        MDTextField:
            id: user_field
            hint_text: "Username"
            icon_right: "account"
            size_hint_x: None
            width: 750
            height: 25
            font_size: 30
            mode: "round"
            padding_x: 10

        MDLabel:
            id: password_label
            text: "PASSWORD"
            font_size: 30
            size_hint_y: None
            height: self.texture_size[1]
            padding_x: 10

        MDTextField:
            id: password_field
            hint_text: "Password"
            icon_right: "eye-off"
            size_hint_x: None
            width: 750
            height: 25
            font_size: 30
            password: True
            mode: "round"
    
        MDBoxLayout: 
            orientation: "horizontal"
            padding: [0,-25]

            MDCheckbox:
                size_hint: None, None
                size: "48dp", "48dp"
                on_active: root.show_password(*args)
                

            MDLabel: 
                id: password_text
                text: "Show Password"
        MDLabel: 
            id: Error
            text: ""
            font_size: 30
            
        MDLabel:
            id: forgotpassword_label
            text: "FORGOT YOUR PASSWORD"
            font_size: 45
            size_hint_y: None
            height: self.texture_size[1]
            padding_y: 10
            padding_x: 10


        MDFillRoundFlatButton:
            text: "FORGOT YOUR PASSWORD"
            font_size: 40
            padding_x: 20
            on_release: Factory.MyPopup().open()

        MDBoxLayout:
            orientation: "horizontal"
            spacing: 40
            padding: [0,-50]

            MDFillRoundFlatButton:
                text: "LOGIN"
                font_size: 40
                pos_hint: {"center_x": 0.5}
                halign: "center"
                on_release: 
                    root.login()
                    root.manager.transition.direction = "left"

                


            MDFillRoundFlatButton:
                text: "CLEAR"
                font_size: 40
                pos_hint: {"center_x": 0.5}
                halign: "center"
                on_release: 
                    root.ids.user_field.text = ""
                    root.ids.password_field.text = ""


        MDScreen:

            MDSmartTile: 
                pos: (1100, 100)
                size_hint: None, None
                size: "400dp", "400dp"
                source: "Login.JPG" 
                radius: [dp(24), dp(24)]
                overlap: False
                box_color: 1,1,1,1

            MDLabel:
                id: SignUp_label
                text: "DON'T HAVE AN ACCOUNT"
                font_size: 45
                size_hint_y: None
                height: self.texture_size[1]
                padding_y: 100
                padding_x: 10
                pos_hint: {"center_x": 0.82}
                halign: "center"


            MDFillRoundFlatButton:
                text: "SIGN UP"
                font_size: 36
                pos_hint: {"center_x": 0.82}
                halign: "center"
                on_release: 
                    root.manager.current = "SignUp"
                    root.manager.transition.direction = "left"

<SignUp>:
    MDCard:

        MDLabel:
            id: signup_label
            text: "WELCOME SIGN UP"
            font_size: 45
            size_hint_y: None
            height: self.texture_size[1]
            padding_y: 10
            padding_x: 10

        
        MDLabel:
            id: username_label
            text: "EMAIL"
            font_size: 40
            size_hint_y: None
            height: self.texture_size[1]
            padding_y: 10
            padding_x: 10
        
        MDTextField:
            id: Email_textfield
            hint_text: "Email"
            icon_right: "email"
            size_hint_x: None
            width: 750
            height: 25
            font_size: 30
            mode: "round"
            padding_x: 10
            

        MDLabel:
            id: username_label
            text: "USERNAME"
            font_size: 40
            size_hint_y: None
            height: self.texture_size[1]
            padding_y: 5
            padding_x: 10

        MDLabel:
            text: "Username must be between 1 and 30 characters, containing no spaces"
        
        MDTextField:
            id: user_textfield
            hint_text: "Username"
            icon_right: "account"
            size_hint_x: None
            width: 750
            height: 25
            font_size: 30
            mode: "round"
            padding_x: 10

        MDLabel:
            id: password_label
            text: "PASSWORD"
            font_size: 40
            size_hint_y: None
            height: self.texture_size[1]
            padding_x: 10
        
        MDLabel:
            text: "Password must contain at least 1 capital letter, special character \n and number, being between 12 and 30 characters in length"
            font_size: 20

        MDTextField:
            id: password_textfield
            hint_text: "Password"
            icon_right: "eye-off"
            size_hint_x: None
            width: 750
            height: 25
            font_size: 30
            password: True
            mode: "round"

        MDBoxLayout:
            orinetation: "horizontal"
            padding: [0,-25]

            MDCheckbox:
                size_hint: None, None
                size: "48dp", "48dp"
                on_active: root.show_password(*args)
                

            MDLabel: 
                id: checkbox
                text: "Show Password"


        MDBoxLayout:
            orientation: "horizontal"
            spacing: 75
            padding: [0,-50]

            MDFillRoundFlatButton:
                text: "SIGN UP"
                font_size: 35
                pos_hint: {"center_x": 0.5}
                halign: "center"
                on_release: 
                    root.signup()
                    root.manager.transition.direction = "right"
            
            MDFillRoundFlatButton:
                text: "CLEAR"
                font_size: 35
                pos_hint: {"center_x": 0.5}
                halign: "center"
                on_release: 
                    root.ids.Email_textfield.text = ""
                    root.ids.user_textfield.text = ""
                    root.ids.password_textfield.text = ""
                    root.ids.confirm_password.text = ""

            MDFillRoundFlatButton:
                text: "BACK"
                font_size: 35
                pos_hint: {"center_x": 0.5}
                halign: "center"
                on_release: 
                    root.manager.current = "Login"
                    root.manager.transition.direction = "right"

            MDLabel: 
                id: Error
                text: ""
                font_size: 30
                
        MDScreen:
            MDSmartTile: 
                pos: (1100, 235)
                size_hint: None, None
                size: "320dp", "320dp"
                source: "SignUp.JPEG" 
                radius: [dp(24), dp(24)]
                overlap: False
                box_color: 1,1,1,1

            MDLabel:
                id: SignUp_label
                text: "CONFIRM PASSWORD"
                font_size: 45
                size_hint_y: None
                height: self.texture_size[1]
                padding_y: 200
                pos_hint: {"center_x": 0.67}
                halign: "center"

            MDTextField:
                id: confirm_password
                hint_text: "Confirm Password"
                icon_right: "eye-off"
                size_hint_x: None
                width: 750
                height: 25
                font_size: 30
                password: True
                mode: "round"
                pos_hint: {"center_x": 0.75}
                pos:(1000,100)

<Account>:
    MDCard: 
        
        MDTopAppBar:
            TopBar:
                id: topbar

        MDLabel: 
            text: "Account Page"
            font_size: 40
            style: "elevated"
            size_hint_x: 0.25
            pos_hint: {"center_x": 0.4}
            

        MDLabel:
            id: User
            text: ""
            font_size: 40
            style: "elevated"
            size_hint_x: 0.25
            pos_hint: {"center_x": 0.4} 
            

        MDBoxLayout: 
            orientation: "horizontal"
            pos_hint: {"center_x": 0.78}
            spacing: 50
            padding: [0,-10]

            MDTextField:
                id: NewUsername
                hint_text: "Change Username"
                size_hint_x: None
                width: 750
                font_size: 30
                mode: "round"
            
            MDFillRoundFlatButton:
                text: "Confirm"
                font_size: 25
                style: "elevated"
                on_release: root.UpdateUsername()

            MDFillRoundFlatButton:
                text: "Clear"
                font_size: 25
                style: "elevated"
                on_release:
                    root.ids.NewUsername.text = ""

        MDLabel:
            id: "Password"
            text: "Change Password:"
            font_size: 40
            style: "elevated"
            size_hint_x: 0.25
            pos_hint: {"center_x": 0.4}

        MDBoxLayout: 
            orientation: "horizontal"
            pos_hint: {"center_x": 0.78}
            spacing: 50
            
            MDTextField:
                id: NewPassword
                hint_text: "Change Password"
                size_hint_x: None
                width: 750
                height: 30
                font_size: 30
                mode: "round"
            
            MDFillRoundFlatButton:
                text: "Confirm"
                font_size: 25
                style: "elevated"
                on_release: root.UpdatePassword()

            MDFillRoundFlatButton:
                text: "Clear"
                font_size: 25
                style: "elevated"
                on_release:
                    root.ids.NewPassword.text = ""

        MDLabel:
            id: Email
            text: ""
            font_size: 40
            style: "elevated"
            size_hint_x: 0.25
            pos_hint: {"center_x": 0.4}
                    
 

        MDBoxLayout: 
            orientation: "horizontal"
            pos_hint: {"center_x": 0.78}
            spacing: 50
            padding: [0,-20]
            
            MDTextField:
                id: NewEmail
                hint_text: "Change Email"
                size_hint_x: None
                width: 750
                height: 30
                font_size: 30
                mode: "round"
            
            MDFillRoundFlatButton:
                text: "Confirm"
                font_size: 25
                style: "elevated" 
                on_release: root.UpdateEmail()

            MDFillRoundFlatButton:
                text: "Clear"
                font_size: 25
                style: "elevated"
                on_release:
                    root.ids.NewEmail.text = ""

        MDLabel:
            id: Error
            text: ""
            font_size: 25
            pos_hint: {"center_x": 0.8}
                      
        NavBar: 
            id: NavBar

<CreateNotes>:
    MDCard: 
        
        MDTopAppBar:
            TopBar:
                id: topbar
                        

        MDLabel:
            text: ""
            font_size: 50
            pos_hint: {"center_x":.4}

        BoxLayout:
            padding: [500,-200]
            orientation: "vertical"

            TextInput:
                id: Title
                hint_text: "Title of Flashcard"
                size_hint: 1.6, 0.5
                multiline: False
                font_size: 34
                canvas.before: 
                    Color: 
                        rgba: (0,0,0,1)
                    Line: 
                        width: 1.5
                        rectangle: self.x, self.y, self.width, self.height
            
            TextInput:
                id: Notes
                hint_text: "Notes"
                size_hint: 1.6, 3.5
                font_size: 25
                canvas.before: 
                    Color: 
                        rgba: (0,0,0,1)
                    Line: 
                        width: 1.5
                        rectangle: self.x, self.y, self.width, self.height

            MDBoxLayout:
                orientation: "horizontal"
                spacing: 65
                padding: [15,20]

                MDFillRoundFlatButton:
                    text: "Clear"
                    font_size: 30
                    on_release: 
                        root.ids.Title.text = ""
                        root.ids.Notes.text = ""

                MDFillRoundFlatButton:
                    id: FlipCard
                    text: "Flip Card"
                    font_size: 30
                    disabled: False
                    on_release: root.FlipCard()

                MDFillRoundFlatButton:
                    text: "Save"
                    font_size: 30
                    on_release: root.save()

                MDFillRoundFlatButton:
                    text: "Add New"
                    font_size: 30
                    on_release: 
                        root.save()
                        root.check("AddNew")
                        root.manager.transition.direction = "right"

                MDFillRoundFlatButton:
                    text: "Finish"
                    font_size: 30
                    on_release: 
                        root.save()
                        root.check("Finish")
                        root.manager.transition.direction = "left"
                        

                MDFillRoundFlatButton:
                    text: "Back"
                    font_size: 30
                    on_release: 
                        root.back()
                        root.manager.transition.direction = "right"


        NavBar: 
            id: NavBar
                
<CreateSelection>:
    MDCard: 
        
        MDTopAppBar:
            TopBar:
                id: topbar
                      

        MDBoxLayout:
            orientation: "vertical" 
            padding: [0,-25]

            MDLabel:
                id: click_label
                text: "Pick the flashcard set below"
                font_size: 30
                pos_hint: {"center_x": 0.78}

            Spinner:
                id: spinner_id
                size_hint: 0.7, None
                pos_hint: {"center_x": 0.62}
                dropdown_cls: "MyDropDown"
                text: "Flashcard Set"
                values: []
                height: 50

                on_text: root.spinner_clicked(spinner_id.text)
            
        BoxLayout:
            id: box
            orientation: "horizontal"
            spacing: 15
            padding: [500,-25]

            MDRaisedButton:
                id: Create
                text: "Create New"
                disabled: False
                on_release: root.addtextinput()

            MDBoxLayout:
                id: SetTitle
                orientation: "horizontal"
                
        MDBoxLayout:
            orientation: "horizontal"
            spacing: 35
            padding: [750,-20]

            MDFillRoundFlatIconButton:
                id: Easy
                text: "Easy Question"
                icon: "close"
                on_release:
                    root.ids.Easy.icon = "check"
                    root.ids.Medium.icon = "close"
                    root.ids.Hard.icon = "close"

            MDFillRoundFlatIconButton:
                id: Medium
                text: "Medium Question"
                icon: "close"
                on_release: 
                    root.ids.Easy.icon = "close"
                    root.ids.Medium.icon = "check"
                    root.ids.Hard.icon = "close"

            MDFillRoundFlatIconButton:
                id: Hard
                text: "Hard Question"
                icon: "close"
                on_release:
                    root.ids.Easy.icon = "close"
                    root.ids.Medium.icon = "close"
                    root.ids.Hard.icon = "check"
        MDLabel:
            text: "By selecting the Q&A format, this allows you to type infomation on both the front and back of the flashcard.\nQuestion on one side, answer on the other."
            font_size: 25
            spacing: 15
            pos_hint: {"center_x": 0.8}
    
            
        MDLabel:
            text: "By selecting the Notes format, this allows you to type infomation on the front of the flashcard,\nin any format you want."
            font_size: 25
            pos_hint: {"center_x": 0.8}

        MDBoxLayout:
            orientation: "horizontal"
            spacing: 150
            padding: [750, -25]

            MDRaisedButton:
                text: "Q&A Format"
                font_size: 30
                size_hint_x: 0.25
                on_release: 
                    root.Format(0)
                    root.manager.transition.direction = "left"

            MDRaisedButton:
                text: "Notes Format"
                font_size: 30
                size_hint_x: 0.25
                on_release: 
                    root.Format(1)
                    root.manager.transition.direction = "left"
                        
        MDLabel:
            id: Error
            text: ""
            font_size: 30
            pos_hint: {"center_x": 0.8}


        NavBar:
            id: NavBar

               
               
<Help>:
    MDCard: 
        
        MDTopAppBar:
            TopBar:
                id: topbar
        
        MDLabel:
            text: "Help Page"
            font_size: 45
            pos_hint: {"center_x": 0.8}
            

        MDBoxLayout: 
            orientation: "vertical"
            padding: [500,0]

            ScrollView:
                size_hint: 1.4, 4.5
                MDList:
                    OneLineIconListItem:
                        id: item1
                        text: "Change Username"
                        on_release: root.press(self, "item1")
                        IconLeftWidget:
                            id: Iconitem1
                            icon: "minus"
                    OneLineIconListItem:
                        id: item2
                        text: "Change Password"
                        on_release: root.press(self, "item2")
                        IconLeftWidget:
                            id: Iconitem2
                            icon: "minus"                    
                    OneLineIconListItem:
                        id: item3
                        text: "Change Email"
                        on_release: root.press(self, "item3")
                        IconLeftWidget:
                            id: Iconitem3
                            icon: "minus"
                    OneLineIconListItem:
                        id: item4
                        text: "Create Flashcard"
                        on_release: root.press(self, "item4")
                        IconLeftWidget:
                            id: Iconitem4
                            icon: "minus"
                    OneLineIconListItem:
                        id: item5
                        text: "Learn Flashcard Set"
                        on_release: root.press(self, "item5")
                        IconLeftWidget:
                            id: Iconitem5
                            icon: "minus"
                    OneLineIconListItem:
                        id: item6
                        text: "Edit Flashcard Set"
                        on_release: root.press(self, "item6")
                        IconLeftWidget:
                            id: Iconitem6
                            icon: "minus"

                    OneLineIconListItem:
                        id: item7
                        text: "Check Progress"
                        on_release: root.press(self, "item7")
                        IconLeftWidget:
                            id: Iconitem7
                            icon: "minus"
                
        MDLabel:
            id: helpbox
            text: ""
            font_size: 30
            pos_hint: {"center_x": 0.62}
            size_hint: 0.65,3.5
            spacing: 50
            halign: 'left'
            valign: 'top'
            canvas.before: 
                Color: 
                    rgba: (0,0,0,1)
                Line: 
                    width: 1.1
                    rectangle: self.x, self.y, self.width, self.height


        NavBar: 
            id: NavBar
           
<Home>:
    MDCard: 
       
        MDTopAppBar:
            TopBar:
                id: topbar

        MDBoxLayout:
            orientation: "horizontal"
            padding: [600,125]
            spacing: 25
            size_hint_x: 1.3

            MDLabel: 
                text: "Home Page"
                font_size: 50
                style: "elevated"
                

            MDLabel: 
                text: "Latest Activity"
                font_size: 50
                style: "elevated"
        

        MDBoxLayout: 
            orientation: "horizontal"
            padding: [500, -200]
            spacing: 100

            MDSmartTile: 
                size_hint: None, None
                size: "300dp", "300dp"
                source: "HomePage.PNG" 
                radius: [dp(32), dp(32)]
                overlap: False
                box_color: 1,1,1,1

            MDBoxLayout: 
                orientation: "vertical"
                spacing: 50
                padding: [0, 100]

                MDRaisedButton: 
                    id: Recent1
                    text: ""
                    font_size: 40
                    style: "elevated"
                    size_hint_x: 3.3
                    disabled: False
                    on_release: 
                        root.GoToSet(0)
                        root.manager.transition.direction = "left"

                MDRaisedButton:
                    id: Recent2
                    text: ""
                    font_size: 40
                    style: "elevated"
                    size_hint_x: 3.3
                    disabled: False
                    on_release: 
                        root.GoToSet(1)
                        root.manager.transition.direction = "left"
                
                MDRaisedButton:
                    id: Recent3 
                    text: ""
                    font_size: 40
                    style: "elevated"
                    size_hint_x: 3.3
                    disabled: False
                    on_release: 
                        root.GoToSet(2)
                        root.manager.transition.direction = "left"

                MDLabel: 
                    id: Error
                    text: ""
                    font_size: 25
        
        NavBar: 
            id: NavBar
<LearnNotes>:
    MDCard: 
        
        MDTopAppBar:
            TopBar:
                id: topbar

        MDLabel:
            text: ""
            font_size: 50
            pos_hint: {"center_x":.4}


        BoxLayout:
            padding: [500,-200]
            orientation: "vertical"

            MDLabel:
                id: Title
                text: ""
                text_size: self.size
                size_hint: 1.6, 0.5
                multiline: False
                font_size: 34
                canvas.before: 
                    Color: 
                        rgba: (0,0,0,1)
                    Line: 
                        width: 1.5
                        rectangle: self.x, self.y, self.width, self.height
                
            
            MDLabel:
                id: Notes
                text: ""
                text_size: self.size
                halign: 'left'
                valign: 'top'
                size_hint: 1.6, 3.5
                font_size: 25
                canvas.before: 
                    Color: 
                        rgba: (0,0,0,1)
                    Line: 
                        width: 1.1
                        rectangle: self.x, self.y, self.width, self.height

            BoxLayout:
                orientation: "horizontal"
                spacing: 65
                padding: [0,20]

                MDFillRoundFlatButton:
                    id: Previous
                    text: "Previous"
                    font_size: 30
                    disabled: False
                    on_release: root.Previous()

                MDFillRoundFlatIconButton:
                    id: FlagButton 
                    text: "Flag"
                    font_size: 30
                    icon: "close"
                    disabled: False
                    on_release: root.Flag()

                MDFillRoundFlatIconButton:
                    id: LearntButton
                    text: "Learnt"
                    font_size: 30
                    icon: "close"
                    disabled: False
                    on_release: root.Learnt()

                MDFillRoundFlatButton:
                    id: Flip
                    text: "Flip Card"
                    font_size: 30
                    disabled: False
                    on_release: root.FlipCard()

                MDFillRoundFlatButton:
                    id: Next
                    text: "Next"
                    font_size: 30
                    disabled: False
                    on_release: root.Next()

                MDFillRoundFlatButton:
                    text: "Back"
                    font_size: 30
                    on_release: 
                        root.close()
                        root.manager.current = "LearnSelection"
                        root.manager.transition.direction = "right"
                        
        NavBar: 
            id: NavBar

<LearnSelection>:
    MDCard: 
        
        MDTopAppBar:
            TopBar:
                id: topbar
        
        MDBoxLayout: 
            orientation: "vertical"
            padding: [500, 0]
            spacing: 15


            MDLabel:
                id: click_label
                text: "Pick the flashcard set that you would like to learn below"
                font_size: 30
            
            Spinner:
                id: spinner_id
                size_hint: 1.6, None
                dropdown_cls: "MyDropDown"
                text: "Flashcard Set"
                values: []
                height: 50                

                on_text: root.spinner_clicked(spinner_id.text)

            MDLabel: 
                text: ""

            MDBoxLayout:
                orientation: "vertical"
                padding: [0,-200]
                spacing: 25

                MDRaisedButton:
                    text: "Learn Set"
                    font_size: 30
                    size_hint: 0.4, None
                    on_release: 
                        app.other_class.loadnotes("Learn")
                        root.manager.transition.direction = "left"
                        

                MDRaisedButton:
                    id: Edit
                    text: "Edit Set"
                    font_size: 30
                    size_hint: 0.4, None
                    width: 150
                    disabled: False
                    on_release: 
                        app.other_class.loadnotes("Edit")
                        root.manager.transition.direction = "left"

                MDRaisedButton:
                    id: Delete
                    text: "Delete Set"
                    font_size: 30
                    size_hint: 0.4, None
                    width: 150
                    disabled: False
                    on_release: 
                        Factory.Confirm().open()

            MDBoxLayout: 
                orientation: "horizontal"
                spacing: 50
                padding: [0,-250]

                MDRaisedButton:
                    text: "View Learnt Cards"
                    font_size: 30
                    size_hint: 0.4, None
                    on_release: 
                        root.manager.transition.direction = "left"
                        app.other_class.loadnotes("Learnt")

                MDRaisedButton:
                    text: "View Flagged Cards"
                    font_size: 30
                    size_hint: 0.4, None
                    on_release: 
                        root.manager.transition.direction = "left"
                        app.other_class.loadnotes("Flagged")
        
        MDBoxLayout:
            orientation: "horizontal"
            padding: [500, -125]
            spacing: 25

            MDRaisedButton: 
                text: "View Easy Qs"
                font_size: 30
                size_hint: 0.4, None
                on_release: 
                    root.manager.transition.direction = "left"
                    app.other_class.loadnotes("Easy")

            MDRaisedButton: 
                text: "View Medium Qs"
                font_size: 30
                size_hint: 0.4, None
                on_release: 
                    root.manager.transition.direction = "left"
                    app.other_class.loadnotes("Medium")

            MDRaisedButton: 
                text: "View Hard Qs"
                font_size: 30
                size_hint: 0.4, None
                on_release: 
                    root.manager.transition.direction = "left"
                    app.other_class.loadnotes("Hard")                
            
        NavBar:
            id: NavBar
           
<Progress>:
    MDCard: 
        
        MDTopAppBar:
            TopBar:
                id: topbar

        MDBoxLayout:
            orientation: "vertical"
            padding: [500, 0]

            MDLabel:
                text: "Progress Page"
                font_size: 40

            MDLabel:
                id: click_label
                text: "Pick the flashcard set below"
                font_size: 30
            
            Spinner:
                id: spinner_id
                size_hint: 1.6, None
                dropdown_cls: "MyDropDown"
                text: "Flashcard Set"
                values: []
                size_hint_y: 0.8

                on_text: root.spinner_clicked(spinner_id.text)

            MDLabel:
                text: ""

            MDBoxLayout:
                orientation: "vertical"
                padding: [0, -200]
                spacing: 30


                MDRaisedButton:
                    text: "Percentaged Viewed"
                    font_size: 50
                    size_hint: 0.85, None
                    on_release:
                        root.PlotViewed() 
                        root.manager.transition.direction = "left"
                        
                MDRaisedButton:
                    text: "Percentaged Flagged"
                    font_size: 50
                    size_hint: 0.85, None
                    on_release: 
                        root.PlotFlagged()
                        root.manager.transition.direction = "left"

                MDRaisedButton:
                    text: "Percentaged Learnt"
                    font_size: 50
                    size_hint: 0.85, None
                    on_release: 
                        root.PlotLearnt()
                        root.manager.transition.direction = "left"

    
        NavBar:
            id: NavBar

